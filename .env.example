# Do not commit a real key. Copy this file to .env and export the variables in your shell.
OPENAI_API_KEY=replace_me
# Optional. Default is gpt-5-mini.
OPENAI_MODEL=gpt-5-mini
APP_ADDR=:8080

# A descriptive application name and developer contact required by hh.ru public API.
HH_USER_AGENT="HH-Auto-Apply/1.0 (your-email@example.com)"

# Do not commit a real key. Copy this file to .env and export the variables in your shell.
OPENAI_API_KEY=replace_me
# Optional. Default is gpt-5-mini.
OPENAI_MODEL=gpt-5-mini
APP_ADDR=:8080

# Create an OAuth application at hh.ru and set its redirect URL to
# http://localhost:8080/auth/hh/callback. Never commit real credentials.
HH_CLIENT_ID=replace_me
HH_CLIENT_SECRET=replace_me
HH_REDIRECT_URL=http://localhost:8080/auth/hh/callback
# A descriptive application name and developer contact required by hh.ru.
HH_USER_AGENT="HH-Auto-Apply/1.0 (your-email@example.com)"
# Local directory for the OAuth token. This directory is ignored by Git.
APP_DATA_DIR=data
